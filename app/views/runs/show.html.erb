<% content_for :title, "Corrida #{@run.id}" %>
<%= turbo_stream_from @run %>

<main class="page">
  <h1>Corrida <%= @run.id %></h1>
  <p>Cada pieza se actualiza sola mientras se consulta su fuente oficial.</p>

  <table class="items">
    <thead>
      <tr>
        <th>Referencia</th><th>Fabricante</th><th>Estado</th>
        <th>Aplicaciones</th><th>Intercambios</th><th>Atributos</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "runs/item", collection: @run.source_items, as: :item %>
    </tbody>
  </table>

  <%= render "runs/download", run: @run %>
</main>
